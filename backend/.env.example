# RecoverAI backend configuration.
# Copy to .env and adjust for your machine. NEVER commit a real .env.
#
# REQUIRED for production:
#   APP_ENV=production
#   AUTH_SECRET_KEY=<random hex, 64 chars>
#   MERCHANT_CREDENTIALS_ENCRYPTION_KEY=<Fernet key>
#   DATABASE_URL=<production PostgreSQL URL>
#   CORS_ORIGINS=<your production domain>
#   RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET + RAZORPAY_WEBHOOK_SECRET

# ─── Application ────────────────────────────────────────────────────
# Environment: development | test | production
# Production MUST set this to "production".
APP_ENV=development

# PostgreSQL connection string (SQLAlchemy format, psycopg3 driver).
DATABASE_URL=postgresql+psycopg://postgres:recoverai_dev@localhost:5432/recoverai

# HTTP server bind address and port.
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed browser origins (no wildcards, no "*").
# Production example: https://app.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

LOG_LEVEL=INFO

# ─── Authentication ────────────────────────────────────────────────
# HMAC-SHA256 signing key for JWT tokens.
# REQUIRED in production — the app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# ─── Encryption ────────────────────────────────────────────────────
# Fernet symmetric key for encrypting Razorpay credentials at rest.
# REQUIRED in production — the app refuses to start without it.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MERCHANT_CREDENTIALS_ENCRYPTION_KEY=

# ─── Razorpay TEST MODE ───────────────────────────────────────────
# Placeholders only — values come from your Razorpay Dashboard →
# Settings → API Keys (Test Mode).
#
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
#       Used for authenticated provider API calls (e.g. payment fetch
#       during reconciliation). NOT used for webhook verification.
#
#   RAZORPAY_WEBHOOK_SECRET
#       The webhook-specific secret set when registering the webhook URL
#       in the Razorpay Dashboard. Used ONLY for webhook signature
#       verification. It is a DIFFERENT credential from KEY_SECRET.
#
# The backend starts fine without these (unrelated features and tests
# run unaffected). Use Test Mode credentials only — never live keys.
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
